# Copy to .env.local (dev) or .env.production.local / the process manager env (prod).
# Never commit real values.

# --- Server-only (never exposed to the browser) ---------------------------

# SAME database as the legacy API (copy MONGODB_URI from the server's knowledgeCapita-API/.env)
MONGODB_URI=mongodb://localhost:27017/sharecom
# Leave false against production. true only for a fresh local DB.
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=10

# MUST equal the legacy API's JWT_SECRET so existing logins keep working after cutover
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Folder containing profile/ and bioFile/ uploads.
# Production: point at the legacy API folder, e.g. /var/www/knowledgeCapita-API/src/storage
STORAGE_PATH=./storage

# Comma-separated origins allowed to call /api/* cross-origin
ALLOWED_ORIGINS=http://localhost:3000,https://knowledgecapita.com

# Public origin for canonical URLs, sitemap.xml and social previews
SITE_URL=https://knowledgecapita.com

# Present in the legacy API but unused there (password reset email is not implemented)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- Public (inlined into the browser bundle at build time) ---------------
# Optional. Defaults to same-origin "/api/" and "/api/storage/".
# NEXT_PUBLIC_API_URL=/api/
# NEXT_PUBLIC_MEDIA_API_URL=/api/storage/
# NEXT_PUBLIC_LOGOUT_REDIRECT_URL=/
