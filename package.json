{
  "name": "knowledgecapita-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "node tests/contract/setup-test-db.mjs",
    "test:contract": "node --test --test-reporter=spec tests/contract/api.contract.test.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "mongoose": "^8.24.5",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-pagination-control": "^1.0.5",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "react-quill-new": "^3.8.3",
    "react-toastify": "^9.1.3",
    "sass": "^1.105.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
